@startuml modelo-clases
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

class User {
  - id: UUID
  - documento: String {unique}
  - nombre: String
  - telefono: String
  - email: String {nullable}
  - passwordHash: String
  - municipio: String
  - vereda: String {nullable}
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + register(): void
  + login(): Token
  + updateProfile(): void
  + getCultivos(): List<Cultivo>
}

class Cultivo {
  - id: UUID
  - userId: UUID {FK}
  - tipoCultivo: TipoCultivo
  - areaHectareas: Decimal
  - fechaSiembra: Date
  - latitud: Decimal {nullable}
  - longitud: Decimal {nullable}
  - estado: EstadoCultivo
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + getFaseFenologica(): FaseFenologica
  + getEdadDias(): Integer
  + getActividades(): List<Actividad>
  + getRecomendaciones(): List<Recomendacion>
  + archivar(): void
}

enum TipoCultivo {
  BANANO
  CAFE
  YUCA
  CACAO
  PLATANO
  OTRO
}

enum EstadoCultivo {
  ACTIVO
  COSECHADO
  ARCHIVADO
}

enum FaseFenologica {
  SIEMBRA
  GERMINACION
  VEGETATIVO
  FLORACION
  FRUCTIFICACION
  MADURACION
}

class Actividad {
  - id: UUID
  - cultivoId: UUID {FK}
  - tipoActividad: TipoActividad
  - fechaHora: DateTime
  - descripcion: Text {nullable}
  - cantidad: Decimal {nullable}
  - unidad: String {nullable}
  - fotoUrl: String {nullable}
  - sincronizado: Boolean
  - createdAt: DateTime
  --
  + marcarComoSincronizada(): void
  + esReciente(): Boolean
}

enum TipoActividad {
  RIEGO
  FERTILIZACION
  FUMIGACION
  PODA
  COSECHA
  OBSERVACION
}

class Recomendacion {
  - id: UUID
  - cultivoId: UUID {FK}
  - tipoRecomendacion: TipoRecomendacion
  - titulo: String
  - descripcion: Text
  - prioridad: Prioridad
  - fechaGeneracion: DateTime
  - fechaExpiracion: DateTime {nullable}
  - leida: Boolean
  - aplicada: Boolean
  - justificacion: Text
  - createdAt: DateTime
  --
  + marcarComoLeida(): void
  + marcarComoAplicada(): void
  + estaVigente(): Boolean
}

enum TipoRecomendacion {
  RIEGO
  FERTILIZACION
  FITOSANITARIA
  GENERAL
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

class Alerta {
  - id: UUID
  - userId: UUID {FK, nullable}
  - cultivoId: UUID {FK, nullable}
  - tipoAlerta: TipoAlerta
  - titulo: String
  - mensaje: Text
  - prioridad: Prioridad
  - fechaEnvio: DateTime
  - leida: Boolean
  - createdAt: DateTime
  --
  + marcarComoLeida(): void
  + esUrgente(): Boolean
}

enum TipoAlerta {
  CLIMATICA
  PLAGA
  SISTEMA
}

class ClimaData {
  - id: UUID
  - municipio: String
  - latitud: Decimal
  - longitud: Decimal
  - fechaHora: DateTime
  - temperatura: Decimal
  - humedad: Decimal
  - precipitacion: Decimal
  - descripcion: String
  - fuente: String
  - createdAt: DateTime
  --
  + esReciente(): Boolean
  + getForecast(): ClimaData[]
}

' Servicios (Capa de Lógica de Negocio)
class RecomendacionService <<Service>> {
  + generarRecomendacionRiego(cultivo: Cultivo, clima: ClimaData): Recomendacion
  + generarRecomendacionFertilizacion(cultivo: Cultivo): Recomendacion
  + evaluarReglas(cultivo: Cultivo, clima: ClimaData): Recomendacion[]
}

class AlertaService <<Service>> {
  + evaluarAlertasClimaticas(ubicacion: String, clima: ClimaData): Alerta[]
  + enviarNotificacionPush(user: User, alerta: Alerta): void
}

class SincronizacionService <<Service>> {
  + sincronizarActividadesPendientes(user: User): void
  + resolverConflictos(local: Actividad, remote: Actividad): Actividad
}

' Relaciones
User "1" --> "0..*" Cultivo : posee >
User "1" --> "0..*" Alerta : recibe >

Cultivo "1" --> "0..*" Actividad : tiene >
Cultivo "1" --> "0..*" Recomendacion : recibe >
Cultivo --> TipoCultivo : tipo
Cultivo --> EstadoCultivo : estado

Actividad --> TipoActividad : tipo

Recomendacion --> TipoRecomendacion : tipo
Recomendacion --> Prioridad : prioridad

Alerta --> TipoAlerta : tipo
Alerta --> Prioridad : prioridad

' Servicios usan entidades
RecomendacionService ..> Cultivo : usa
RecomendacionService ..> ClimaData : usa
RecomendacionService ..> Recomendacion : crea

AlertaService ..> ClimaData : usa
AlertaService ..> Alerta : crea
AlertaService ..> User : notifica

SincronizacionService ..> Actividad : sincroniza

note right of RecomendacionService
  Motor de recomendaciones
  basado en reglas configura-
  bles validadas por expertos
end note

note bottom of Cultivo
  Calcula fase fenológica
  en base a fecha de siembra
  y tipo de cultivo
end note

@enduml
