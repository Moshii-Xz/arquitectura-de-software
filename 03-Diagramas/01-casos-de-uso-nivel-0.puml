@startuml nivel-0.puml
left to right direction
skinparam packageStyle rectangle

' =====================
' Actores
' =====================
actor "Productor de la finca" as Productor
actor "Administrador" as Admin
actor "Asociaciones agrícolas" as Asociaciones
actor "Entidades Regulatorias" as Entidades
actor "Servicio Climático Externo\n(IDEAM)" as IDEAM

' =====================
' Límite del Sistema
' =====================
package "Plataforma Agricultura Inteligente" {

  usecase "Gestionar Perfil y Finca" as UC1
  usecase "Gestionar Actividades de Cultivo" as UC2
  usecase "Consultar Recomendaciones y Alertas" as UC3
  usecase "Generar Reportes de Producción" as UC4
  usecase "Sincronizar Datos" as UC5
  usecase "Administrar Usuarios y Parámetros" as UC6
}

' =====================
' Relaciones Productor
' =====================
Productor --> UC1
Productor --> UC2
Productor --> UC3
Productor --> UC4
Productor --> UC5

' =====================
' Relaciones Administrador
' =====================
Admin --> UC6
Admin --> UC5

' =====================
' Relaciones Externas
' =====================
IDEAM --> UC3

Asociaciones --> UC4
Entidades --> UC4

@enduml