@startuml casos-de-uso
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle

left to right direction

actor "Productor" as Productor
actor "Asociacion de\nProductores" as Asociacion
actor "Administrador" as Admin
actor "Servicio Climatico\nExterno" as Clima

rectangle "Plataforma Agricultura Inteligente" {
  package "Gestion de Perfil" {
    usecase (Registrar Usuario) as UC1
    usecase (Autenticar Usuario) as UC2
    usecase (Gestionar Perfil) as UC3
    usecase (Configurar Preferencia\nde Notificacion) as UC4
  }

  package "Gestion de Cultivos" {
    usecase (Registrar Cultivo) as UC5
    usecase (Consultar Estado\nde Cultivo) as UC6
    usecase (Actualizar Cultivo) as UC7
    usecase (Archivar Cultivo) as UC8
  }

  package "Registro de Actividades" {
    usecase (Registrar Actividad) as UC9
    usecase (Consultar Historial\nde Actividad) as UC10
    usecase (Programar Recordatorio\nde Actividad) as UC11
  }

  package "Clima y Recomendaciones" {
    usecase (Consultar Condicion\nClimatica) as UC12
    usecase (Consultar Recomendacion) as UC13
    usecase (Generar Recomendacion\nde Riego) as UC14
    usecase (Generar Recomendacion\nde Fertilizacion) as UC15
    usecase (Generar Recomendacion\nFitosanitaria) as UC16
    usecase (Consultar Historial\nde Recomendacion) as UC17
  }

  package "Alertas y Notificaciones" {
    usecase (Gestionar Alerta\nClimatica) as UC18
    usecase (Gestionar Notificacion) as UC19
    usecase (Consultar Centro\nde Notificacion) as UC20
  }

  package "Sincronizacion Offline" {
    usecase (Operar en Modo\nOffline) as UC21
    usecase (Sincronizar Dato\nAutomaticamente) as UC22
    usecase (Sincronizar Dato\nManualmente) as UC23
  }

  package "Contenido y Administracion" {
    usecase (Consultar Contenido\nEducativo) as UC24
    usecase (Gestionar Reporte\nConsolidado) as UC25
    usecase (Gestionar Catalogo\ny Parametro) as UC26
    usecase (Gestionar Usuario) as UC27
    usecase (Monitorear Sistema) as UC28
    usecase (Obtener Dato\nClimatico Externo) as UC29
  }
}

Productor --> UC1
Productor --> UC2
Productor --> UC3
Productor --> UC5
Productor --> UC6
Productor --> UC7
Productor --> UC13
Productor --> UC18
Productor --> UC19
Productor --> UC20
Productor --> UC21
Productor --> UC22
Productor --> UC23
Productor --> UC24

Asociacion --> UC25

Admin --> UC25
Admin --> UC26
Admin --> UC27
Admin --> UC28

Clima --> UC29 : provee datos

UC3 ..> UC2 : <<include>>
UC13 ..> UC14 : <<include>>
UC13 ..> UC15 : <<include>>
UC13 ..> UC16 : <<include>>
UC13 ..> UC17 : <<include>>

UC12 ..> UC29 : <<include>>
UC18 ..> UC12 : <<include>>
UC18 ..> UC19 : <<include>>

UC21 ..> UC9 : <<include>>
UC22 ..> UC21 : <<include>>
UC23 ..> UC21 : <<include>>

note right of UC21
  Flujo clave del proyecto:
  operar con conectividad
  intermitente y sincronizar
  cuando haya red
end note

note bottom of UC13
  Motor de recomendaciones
  basado en reglas validadas
  por expertos agronomos
end note

@enduml
