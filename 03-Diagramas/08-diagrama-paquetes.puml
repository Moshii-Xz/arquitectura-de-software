@startuml
title Diagrama de Paquetes - Plataforma Agricultura Inteligente

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

package "Presentación" as PRESENTACION {
  [Interfaz Web]
}

package "Aplicación" as APLICACION {
  [Servicios de Aplicación]
}

package "Dominio" as DOMINIO {
  [Autenticación]
  [Gestión de Usuarios]
  [Gestión de Cultivos]
  [Gestión de Insumos]
  [Recomendaciones]
  [Reportes]
  [Notificaciones]
  [Sincronización]
}

package "Persistencia" as PERSISTENCIA {
  [Repositorios]
}

package "Utilidades" as UTIL {
  [ObjetoID]
  [Validaciones]
  [Fechas]
}

' Dependencias por capas (CORRECTO)
PRESENTACION ..> APLICACION
APLICACION ..> DOMINIO
DOMINIO ..> PERSISTENCIA

' Uso transversal
DOMINIO ..> UTIL
PERSISTENCIA ..> UTIL

@enduml