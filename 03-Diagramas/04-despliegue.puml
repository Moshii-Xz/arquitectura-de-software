@startuml despliegue
!theme plain
skinparam nodeStyle rectangle

actor "Pequeño Productor" as User #lightblue

node "Dispositivo Android\n(Gama Baja)" as AndroidDevice #E3F2FD {
  artifact "Aplicación Móvil\n(Flutter APK)" as App #90CAF9
  database "SQLite\n(Local)" as SQLite #64B5F6
  
  App -down-> SQLite : "lee/escribe"
}

cloud "Internet\n(3G/4G/WiFi)" as Internet #FFF9C4 {
  node "HTTPS/TLS 1.2+" as HTTPS
}

node "Railway.app (PaaS)\nDatacenter: US East" as Railway #E8F5E9 {
  
  node "Contenedor Docker\nNode.js 18 LTS" as BackendContainer #C8E6C9 {
    artifact "Backend API\n(Express.js)" as Backend #81C784
    
    component "Cron Jobs" as Cron #66BB6A {
      [Clima Update: cada 6h]
      [Alertas: cada 1h]
      [Recomendaciones: diario]
    }
  }
  
  node "PostgreSQL 14\n(Gestionado por Railway)" as PostgresNode #4CAF50 {
    database "Base de Datos\nProducción" as PostgreSQL #2E7D32
  }
  
  Backend -down-> PostgreSQL : "SQL\nSequelize ORM"
}

cloud "Servicios Externos" #FFF3E0 {
  
  node "OpenWeatherMap\nAPI Server" as WeatherAPI #FFE082 {
    artifact "API REST\nDatos Climáticos" as WeatherService
  }
  
  node "Firebase\n(Google Cloud)" as Firebase #FFCA28 {
    artifact "Firebase Cloud\nMessaging (FCM)" as FCM #FFA726
  }
}

node "GitHub" as GitHub #E1BEE7 {
  artifact "Repositorio\nCódigo Fuente" as Repo #CE93D8
}

node "Google Play Store" as PlayStore #A5D6A7 {
  artifact "Aplicación\nPublicada (APK)" as PublishedApp
}

' Conexiones principales
User -down-> AndroidDevice : "usa"
AndroidDevice -down-> Internet : "3G/4G/WiFi"
Internet -down-> Railway : "HTTPS"
App -down-> HTTPS : "REST API\nJSON"
HTTPS -down-> Backend

' Servicios externos
Backend -right-> WeatherAPI : "HTTPS\nAPI Key"
Backend -right-> FCM : "HTTPS\nCredenciales"
FCM -up-> Internet : "notificaciones push"
Internet -up-> App : "push notification"

' CI/CD
Repo -down-> Railway : "Webhook\nDeploy automático"
Repo -down-> PlayStore : "Release\nmanual"
PlayStore -up-> AndroidDevice : "Instalación/\nActualización"

' Escalabilidad futura (dotted)
node "Futuro: Redis\n(Caché)" as Redis #FFCDD2 {
  database "Caché\nDistribuido" as RedisDB
}
Backend ..> Redis : "futuro\nescalamiento"

note right of AndroidDevice
  **Especificaciones mínimas:**
  - Android 7.0+
  - 2GB RAM
  - 100MB espacio libre
  - Conexión intermitente
end note

note bottom of Railway
  **Costos estimados:**
  - Tier gratuito: $5/mes
  - Plan Starter: $5-10/mes
  - Soporta hasta 1000+ usuarios
  
  **Includes:**
  - PostgreSQL gestionado
  - Backups automáticos
  - SSL/TLS gratis
  - CI/CD integrado
end note

note right of WeatherAPI
  **Tier gratuito:**
  - 1000 llamadas/día
  - Suficiente para 200+ usuarios
  - Actualización cada 6h
end note

note right of FCM
  **Tier gratuito:**
  - Notificaciones ilimitadas
  - Latencia < 1 segundo
  - Alta confiabilidad
end note

note left of PostgreSQL
  **Base de Datos:**
  - PostgreSQL 14
  - 1GB storage (tier gratuito)
  - Backups diarios automáticos
  - Conexiones: hasta 100
end note

@enduml
