@startuml nivel 1 gestionar reportes
left to right direction

skinparam actorStyle awesome
actor "Productor Agrícola" as Productor
actor "Asociaciones Agrícolas" as Asociacion
actor "Administrador" as Admin

package "Gestionar Reportes" {

  usecase "Generar Reporte\nde Estado de Cultivos" as UC1
  usecase "Generar Reporte de\nConsumo de Insumos" as UC2
  usecase "Generar Reporte de\nAlertas Recibidas" as UC3
  usecase "Generar Reporte\nComparativo" as UC4
  usecase "Filtrar por\nPeriodo de Tiempo" as UC5
  usecase "Exportar Reporte\na PDF" as UC6
}

Productor --> UC1
Productor --> UC2
Productor --> UC3
Productor --> UC4

Asociacion --> UC1
Asociacion --> UC3
Asociacion --> UC4

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4

UC1 ..> UC5 : <<extend>>
UC1 ..> UC6 : <<include>>

UC2 ..> UC5 : <<extend>>
UC2 ..> UC6 : <<include>>

UC3 ..> UC5 : <<extend>>
UC3 ..> UC6 : <<include>>

UC4 ..> UC5 : <<extend>>
UC4 ..> UC6 : <<include>>

@enduml

@enduml