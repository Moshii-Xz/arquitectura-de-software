@startuml despliegue_api_pura
title Diagrama de Despliegue - Plataforma Agricultura Inteligente

' =========================
' CLIENTES FRONTALES INDEPENDIENTES
' =========================
node "Clientes Frontales Independientes" as clientes {
  artifact "Frontend Web / React" as frontend
}

' =========================
' SERVIDOR (BACKEND MONOLÍTICO POR CAPAS)
' =========================
node "Servidor de Aplicaciones" as appserver {

  ' Capa Presentación / API
  [AuthController]
  [CultivoController]
  [InsumoController]
  [ReporteController]

  ' Capa Aplicación / Servicios
  [AuthService]
  [CultivoService]
  [InsumoService]
  [ReporteService]

  ' Capa Dominio
  [Usuario]
  [Cultivo]
  [Insumo]
  [Recomendacion]

  ' Capa Persistencia
  [UsuarioRepository]
  [CultivoRepository]
  [InsumoRepository]
  [ReporteRepository]
}

' =========================
' BASE DE DATOS
' =========================
node "Base de Datos" as dbserver {
  database "PostgreSQL" as db
}

' =========================
' SERVICIO EXTERNO (IMPORTANTE)
' =========================
node "IDEAM / Servicio Climático" as ideam


' =========================
' CONEXIONES CLIENTE → BACKEND
' =========================
frontend --> [AuthController] : HTTPS / JSON
frontend --> [CultivoController] : HTTPS / JSON
frontend --> [ReporteController] : HTTPS / JSON

' =========================
' FLUJO INTERNO (CAPAS)
' =========================
[AuthController] --> [AuthService]
[CultivoController] --> [CultivoService]
[InsumoController] --> [InsumoService]
[ReporteController] --> [ReporteService]

[AuthService] --> [Usuario]
[CultivoService] --> [Cultivo]
[InsumoService] --> [Insumo]

[AuthService] --> [UsuarioRepository]
[CultivoService] --> [CultivoRepository]
[InsumoService] --> [InsumoRepository]
[ReporteService] --> [ReporteRepository]

' =========================
' BASE DE DATOS
' =========================
[UsuarioRepository] --> db : JDBC / SQL
[CultivoRepository] --> db : JDBC / SQL
[InsumoRepository] --> db : JDBC / SQL
[ReporteRepository] --> db : JDBC / SQL

appserver --> ideam : HTTPS / REST API (RF-38)

@enduml