@startuml diagrama de desplgieue
title Diagrama de Despliegue - Arquitectura por Capas

node "Cliente Web" {
  artifact "Navegador moderno" as browser
  artifact "Frontend web responsivo" as webapp
}

node "Servidor de Aplicaciones" {
  artifact "Spring Boot API REST" as api
  [Presentación] as presentacion
  [Lógica de Negocio] as negocio
  [Persistencia] as persistencia
}

node "Servidor de Base de Datos" {
  database "PostgreSQL" as postgres
}



' Conexiones
webapp --> presentacion : HTTPS / JSON
presentacion --> negocio
negocio --> persistencia
persistencia --> postgres : JDBC / TCP


' Despliegue
webapp ..> browser : <<deploy>>
api ..> presentacion : <<deploy>>

@enduml