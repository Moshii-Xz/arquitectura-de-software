@startuml
title Diagrama de Despliegue - Plataforma Agricultura Inteligente

' =========================
' CLIENTE
' =========================
node "Cliente Web" {
  artifact "Navegador" as navegador
}

' =========================
' SERVIDOR (BACKEND MONOLÍTICO POR CAPAS)
' =========================
node "Servidor de Aplicaciones" {

  ' Capa Presentación
  [AuthController]
  [CultivoController]
  [InsumoController]
  [ReporteController]

  ' Capa Aplicación / Servicios
  [AuthService]
  [CultivoService]
  [InsumoService]
  [ReporteService]

  ' Capa Dominio
  [Usuario]
  [Cultivo]
  [Insumo]
  [Recomendacion]

  ' Capa Persistencia
  [UsuarioRepository]
  [CultivoRepository]
  [InsumoRepository]
  [ReporteRepository]
}

' =========================
' BASE DE DATOS
' =========================
node "Base de Datos" {
  database "PostgreSQL" as db
}

' =========================
' SERVICIO EXTERNO (IMPORTANTE)
' =========================


' =========================
' CONEXIONES CLIENTE → BACKEND
' =========================
navegador --> [AuthController] : HTTPS / JSON
navegador --> [CultivoController] : HTTPS / JSON
navegador --> [ReporteController] : HTTPS / JSON

' =========================
' FLUJO INTERNO (CAPAS)
' =========================
[AuthController] --> [AuthService]
[CultivoController] --> [CultivoService]
[InsumoController] --> [InsumoService]
[ReporteController] --> [ReporteService]

[AuthService] --> [Usuario]
[CultivoService] --> [Cultivo]
[InsumoService] --> [Insumo]

[AuthService] --> [UsuarioRepository]
[CultivoService] --> [CultivoRepository]
[InsumoService] --> [InsumoRepository]
[ReporteService] --> [ReporteRepository]

' =========================
' BASE DE DATOS
' =========================
[UsuarioRepository] --> db : JDBC / SQL
[CultivoRepository] --> db : JDBC / SQL
[InsumoRepository] --> db : JDBC / SQL

@enduml