@startuml
title Diagrama de Clases - Modelo Lógico

class Usuario {
  +id: UUID
  +nombre: String
  +correo: String
  +passwordHash: String
  +estado: String
  +ultimoAcceso: DateTime
}

class Rol {
  +id: UUID
  +nombre: String
}

class Perfil {
  +id: UUID
  +telefono: String
  +idioma: String
  +preferenciasNotificacion: String
  +latitud: Decimal
  +longitud: Decimal
}

class Cultivo {
  +id: UUID
  +nombre: String
  +tipo: String
  +fechaSiembra: Date
  +estado: String
  +fechaEstado: Date
}

class HistorialEstadoCultivo {
  +id: UUID
  +estado: String
  +fechaCambio: DateTime
}

class FotoCultivo {
  +id: UUID
  +url: String
  +fechaRegistro: DateTime
}

class ObservacionCultivo {
  +id: UUID
  +descripcion: String
  +fechaRegistro: DateTime
}

class CatalogoInsumo {
  +id: UUID
  +nombre: String
  +impactoAmbiental: String
  +unidad: String
}

class AplicacionInsumo {
  +id: UUID
  +cantidad: Decimal
  +costo: Decimal
  +fechaAplicacion: DateTime
  +editableHasta: DateTime
}

class Recomendacion {
  +id: UUID
  +tipo: String
  +prioridad: Integer
  +justificacion: String
  +estado: String
  +fechaGeneracion: DateTime
}

class Notificacion {
  +id: UUID
  +tipo: String
  +mensaje: String
  +leida: Boolean
  +fecha: DateTime
}

class Reporte {
  +id: UUID
  +tipo: String
  +periodoInicio: Date
  +periodoFin: Date
  +formato: String
  +fechaGeneracion: DateTime
}

class Auditoria {
  +id: UUID
  +accion: String
  +modulo: String
  +fecha: DateTime
  +ip: String
}

Usuario "1" --> "1" Perfil
Usuario "*" --> "1" Rol
Usuario "1" --> "*" Cultivo
Cultivo "1" --> "*" HistorialEstadoCultivo
Cultivo "1" --> "*" FotoCultivo
Cultivo "1" --> "*" ObservacionCultivo
Cultivo "1" --> "*" AplicacionInsumo
AplicacionInsumo "*" --> "1" CatalogoInsumo
Cultivo "1" --> "*" Recomendacion
Usuario "1" --> "*" Notificacion
Usuario "1" --> "*" Reporte
Usuario "1" --> "*" Auditoria

@enduml