@startuml base-de-datos
!theme plain
skinparam linetype ortho

entity "users" as User {
  * id : UUID <<PK>>
  --
  * documento : VARCHAR(20) <<UK>>
  * nombre : VARCHAR(100)
  * telefono : VARCHAR(15)
  email : VARCHAR(100)
  * password_hash : VARCHAR(255)
  * municipio : VARCHAR(50)
  vereda : VARCHAR(50)
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "cultivos" as Cultivo {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * tipo_cultivo : ENUM
  * area_hectareas : DECIMAL(8,2)
  * fecha_siembra : DATE
  latitud : DECIMAL(10,8)
  longitud : DECIMAL(11,8)
  * estado : ENUM
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "actividades" as Actividad {
  * id : UUID <<PK>>
  --
  * cultivo_id : UUID <<FK>>
  * tipo_actividad : ENUM
  * fecha_hora : TIMESTAMP
  descripcion : TEXT
  cantidad : DECIMAL(10,2)
  unidad : VARCHAR(20)
  foto_url : VARCHAR(255)
  * sincronizado : BOOLEAN
  * created_at : TIMESTAMP
}

entity "recomendaciones" as Recomendacion {
  * id : UUID <<PK>>
  --
  * cultivo_id : UUID <<FK>>
  * tipo_recomendacion : ENUM
  * titulo : VARCHAR(200)
  * descripcion : TEXT
  * prioridad : ENUM
  * fecha_generacion : TIMESTAMP
  fecha_expiracion : TIMESTAMP
  * leida : BOOLEAN
  * aplicada : BOOLEAN
  justificacion : TEXT
  * created_at : TIMESTAMP
}

entity "alertas" as Alerta {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  cultivo_id : UUID <<FK>>
  * tipo_alerta : ENUM
  * titulo : VARCHAR(200)
  * mensaje : TEXT
  * prioridad : ENUM
  * fecha_envio : TIMESTAMP
  * leida : BOOLEAN
  * created_at : TIMESTAMP
}

entity "clima_data" as ClimaData {
  * id : UUID <<PK>>
  --
  * municipio : VARCHAR(50)
  * latitud : DECIMAL(10,8)
  * longitud : DECIMAL(11,8)
  * fecha_hora : TIMESTAMP
  * temperatura : DECIMAL(5,2)
  * humedad : DECIMAL(5,2)
  * precipitacion : DECIMAL(8,2)
  descripcion : VARCHAR(100)
  * fuente : VARCHAR(50)
  * created_at : TIMESTAMP
}

entity "tipos_cultivo_config" as TipoCultivoConfig {
  * id : UUID <<PK>>
  --
  * nombre : VARCHAR(50) <<UK>>
  * duracion_dias_promedio : INTEGER
  fases_fenologicas : JSON
  requerimientos_hidricos : JSON
  parametros_recomendacion : JSON
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

' Relaciones
User ||--o{ Cultivo : "posee"
User ||--o{ Alerta : "recibe"

Cultivo ||--o{ Actividad : "tiene"
Cultivo ||--o{ Recomendacion : "recibe"
Cultivo }o--|| TipoCultivoConfig : "es de tipo"

note right of User
  Autenticación:
  - password_hash usa bcrypt
  - JWT para sesiones
  Índices:
  - documento (unique)
  - municipio (búsqueda)
end note

note bottom of Cultivo
  Estado puede ser:
  - ACTIVO
  - COSECHADO
  - ARCHIVADO
  
  Índices:
  - user_id (FK)
  - fecha_siembra
  - estado
end note

note right of Actividad
  sincronizado indica si
  fue registrado offline
  y ya se sincronizó con
  el servidor
  
  Índices:
  - cultivo_id (FK)
  - fecha_hora
  - sincronizado
end note

note left of ClimaData
  Cacheo de datos
  climáticos para
  reducir llamadas
  a APIs externas
  
  TTL: 6 horas
  
  Índices:
  - municipio + fecha_hora
end note

note bottom of TipoCultivoConfig
  Configuración de
  parámetros por tipo
  de cultivo (banano,
  café, yuca, etc.)
  
  Gestionado desde
  panel de admin
end note

@enduml

- **Node.js 18 LTS**
- **Express.js 4.x**
- **PostgreSQL 14+**
- **Librerías principales:**
  - `sequelize` - ORM
  - `jsonwebtoken` - Autenticación JWT
  - `bcrypt` - Hashing de contraseñas
  - `express-validator` - Validación
  - `node-cron` - Tareas programadas
  - `axios` - Cliente HTTP (APIs externas)

---

## Instalación y Configuración

### Prerrequisitos

- Flutter SDK 3.16+
- Android Studio / VS Code con extensiones Flutter
- Node.js 18+
- PostgreSQL 14+
- Git

### Configuración Backend

```bash
# Clonar repositorio
git clone https://github.com/tu-usuario/agro-backend.git
cd agro-backend

# Instalar dependencias
npm install

# Configurar variables de entorno
cp .env.example .env
# Editar .env con tus credenciales

# Ejecutar migraciones
npm run migrate

# Iniciar servidor de desarrollo
npm run dev
```

### Configuración Frontend

```bash
# Clonar repositorio
git clone https://github.com/tu-usuario/agro-app.git
cd agro-app

# Instalar dependencias
flutter pub get

# Configurar constantes (URL del backend)
# Editar lib/core/constants/api_constants.dart

# Ejecutar en emulador/dispositivo
flutter run
```

---

